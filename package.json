{
  "name": "sokoban",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "editor": "vite --port 5174 --open /editor.html",
    "build": "tsc --noEmit && vite build",
    "build:editor": "tsc --noEmit && vite build --mode editor",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run knip && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.40.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
